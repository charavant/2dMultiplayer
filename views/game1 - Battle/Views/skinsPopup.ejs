<div id="skinsPopup" class="popup">
  <div id="skinsContainer" class="ship-picker custom-scrollbar">
    <div class="flight-label">THE HANGAR</div>
    <h3>Choose your ship</h3>
    <p>Find your silhouette. Every ship has the same hit area.</p>
    <div id="skinsGrid" class="ship-grid">
      <button type="button" data-skin="" class="skinOption" aria-pressed="false">
        <img src="/assets/PlayersSkins/ship-interceptor.png" alt=""><span>Team default</span>
      </button>
      <% playerSkins.forEach(function(s){ %>
        <button type="button" data-skin="<%= s %>" class="skinOption" aria-pressed="false">
          <img src="/skin?file=<%= encodeURIComponent(s) %>&w=96&h=96" alt="">
          <span><%= s.replace(/^ship-/, '').replace(/\.png$/i, '').replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase()) %></span>
        </button>
      <% }) %>
    </div>
    <button id="closeSkins" class="popupBtn mt-3">Close</button>
  </div>
</div>
